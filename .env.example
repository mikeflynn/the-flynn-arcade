# Optional: copy this file to .env on the server (.env is never committed).

# The port the arcade listens on, on 127.0.0.1 only. Change it if 8000 is taken
# on your server, and use the same number in your Caddy site block.
ARCADE_PORT=8000

# Which published images to run. "latest" is the newest push to main. To go
# back to an earlier version, set this to that commit's full SHA (each image
# is also tagged with the commit it was built from).
IMAGE_TAG=latest

# Where the images come from (change this if you run your own fork).
IMAGE_PREFIX=ghcr.io/mikeflynn/the-flynn-arcade
